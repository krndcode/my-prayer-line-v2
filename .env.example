# ---------------------------------------------------------------------------
# Firebase web app config (safe to expose in the browser)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# LiveKit Cloud (group audio/video calls)
# Create a project at https://cloud.livekit.io.
# Leave all three blank to disable calling gracefully.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# Server-only secrets. NEVER prefix these with NEXT_PUBLIC_.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---------------------------------------------------------------------------
# Firebase Admin (server-only) verifies Firebase ID tokens before issuing
# LiveKit tokens. Paste the FULL service account JSON object as a single line
# (escape the private key newlines as \n). This is required for calls both
# locally and on Vercel; there is no Application Default Credentials fallback.
# ---------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT=
